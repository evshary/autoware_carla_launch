FROM ghcr.io/autowarefoundation/autoware:universe-devel-cuda-jazzy-1.8.0

# Download necessary packages
RUN apt-get update
# Useful tools
RUN apt-get install -y wget unzip tmux inetutils-ping curl vim parallel
RUN printf 'set-option -g default-shell /bin/bash\nset -g default-terminal "tmux-256color"' > /etc/tmux.conf
# Used by zenoh-bridge-ros2dds
RUN apt-get install -y llvm-dev libclang-dev cmake
# Used by Autoware & my ROS packages
RUN python3 -m pip install --break-system-packages gdown
RUN apt-get install -y ros-jazzy-moveit-msgs \
                       ros-jazzy-object-recognition-msgs \
                       ros-jazzy-octomap-msgs \
                       ros-jazzy-rmw-zenoh-cpp \
                       ros-jazzy-xacro \
                       ros-jazzy-topic-tools \
                       ros-jazzy-rviz2
# chrony: NTP daemon for system_monitor's clock check
# https://github.com/autowarefoundation/autoware_universe/issues/12870
RUN apt-get install -y chrony
# Used by zenoh_autoware_v2x
ENV PATH="/root/.cargo/bin:${PATH}"
ENV RUSTUP_PERMIT_COPY_RENAME=true
RUN python3 -m pip install --break-system-packages eclipse-zenoh==1.9.0
CMD bash
